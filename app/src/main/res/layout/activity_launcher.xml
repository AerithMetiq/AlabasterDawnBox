<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher: the game's own title art behind (once it is downloaded), a scrim for legibility, the
     wordmark on the left, sign-in or PLAY on the right, and a status strip pinned to the bottom so the
     spinner and download bar are always on screen. Landscape-first, controller-navigable. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg"
    android:fitsSystemWindows="true">
    <!-- fitsSystemWindows: Android 15+ draws apps edge to edge, so the controls are kept clear of the
         status and navigation bars while the background still fills the whole screen. -->

    <ImageView
        android:id="@+id/game_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="44dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp">

            <!-- left: the wordmark (no game logo ships in the APK) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.12"
                    android:shadowColor="#99000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:text="ALABASTER"
                    android:textColor="@color/alabaster"
                    android:textSize="38sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.5"
                    android:text="DROID"
                    android:textColor="@color/accent"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.3"
                    android:text="STEAM CLOUD LAUNCHER"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- right: sign-in, or the PLAY controls -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- signed out -->
                <LinearLayout
                    android:id="@+id/signed_out"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Steam username"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent"
                        app:hintTextColor="@color/accent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="flagNoExtractUi|actionNext"
                            android:inputType="text"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Steam password"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_secondary"
                        app:hintTextColor="@color/accent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="flagNoExtractUi|actionDone"
                            android:inputType="textPassword"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sign_in"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:minHeight="50dp"
                        android:text="Sign in with Steam"
                        android:textAllCaps="false"
                        android:textColor="@color/on_accent"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/focus_ring"
                        app:strokeWidth="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sign_in_qr"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="46dp"
                        android:text="Sign in with QR code"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:rippleColor="@color/accent"
                        app:strokeColor="@color/focus_ring_outline"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- signed in -->
                <LinearLayout
                    android:id="@+id/signed_in"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/play"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="▶  PLAY"
                        android:textAllCaps="false"
                        android:textColor="@color/on_accent"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="21sp"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        app:backgroundTint="@color/accent"
                        app:cornerRadius="16dp"
                        app:elevation="6dp"
                        app:strokeColor="@color/focus_ring"
                        app:strokeWidth="2dp" />

                    <TextView
                        android:id="@+id/play_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/offline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="@color/accent"
                        android:text="Play offline (skip cloud sync)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings"
                            style="@style/LauncherTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Settings" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sign_out"
                            style="@style/LauncherTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Sign out" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- status strip, always visible -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="44dp"
            android:paddingBottom="16dp">

            <ProgressBar
                android:id="@+id/busy"
                style="?android:attr/progressBarStyle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="6dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/download_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="@color/accent"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/avatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:contentDescription="Steam avatar"
        android:padding="1dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/CircleAvatar"
        app:strokeColor="@color/accent"
        app:strokeWidth="1.5dp" />
</FrameLayout>

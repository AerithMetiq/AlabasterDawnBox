<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Steam: sign-in, the game download and Steam Cloud. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The game download carries on in the background: a foreground service with a progress
         notification, kept awake while the screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- appCategory="game": tells Android this is a game, so a device's game mode and performance
         profile treat it as one. The game is limited by one busy thread that has to get a fast core. -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".CloudSavesActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".SteamProbeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <service
            android:name=".GameDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shows the account as playing on Steam while the game runs (off unless turned on). -->
        <service
            android:name=".PlayingService"
            android:exported="false" />

        <!-- The game itself, in a process of its own: leaving the game ends that process (as the
             host does in alabaster-android) and the launcher underneath is untouched. -->
        <activity
            android:name=".host.GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
    </application>

</manifest>
